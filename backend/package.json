{
  "name": "roam-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/db/migrations/migrate.ts"
  },
  "dependencies": {
    "@clerk/backend": "latest",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "tsx": "^4.19.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "body-parser": "1.20.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
